<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-configuration PUBLIC "-//Hibernate/Hibernate Configuration DTD 3.0//EN" "http://www.hibernate.org/dtd/hibernate-configuration-3.0.dtd">
<hibernate-configuration>
    <session-factory>
        <!-- Configurações de Conexão -->
        <property name="hibernate.connection.driver_class">org.postgresql.Driver</property>
        <property name="hibernate.connection.url">jdbc:postgresql://localhost:5432/barbershop</property>
        <property name="hibernate.connection.username">postgres</property>
        <property name="hibernate.connection.password">1234</property>
        
        <!-- Dialeto do PostgreSQL -->
        <property name="hibernate.dialect">org.hibernate.dialect.PostgreSQLDialect</property>
        
        <!-- Cria/Atualiza as tabelas automaticamente -->
        <property name="hibernate.hbm2ddl.auto">update</property>
        
        <!-- Mostra o SQL no console -->
        <property name="show_sql">true</property>
        
        <!-- Mapeamento das classes (será feito no próximo passo) -->
        <mapping class="Model.Cliente"/>
        <mapping class="Model.Servico"/>
        <mapping class="Model.Usuario"/>
        <mapping class="Model.Agendamento"/>
    </session-factory>
</hibernate-configuration>